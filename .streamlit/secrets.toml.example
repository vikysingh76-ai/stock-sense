# IMPORTANT: editing THIS file does nothing for the running app -- it is
# just a template and is tracked by git. The app only reads from the file
# below once you create it (or from a real environment variable / .env
# file), which is git-ignored so your real key never gets committed:
#
#   cp .streamlit/secrets.toml.example .streamlit/secrets.toml
#   # then edit .streamlit/secrets.toml (NOT this .example file) and paste
#   # your real, full key there.
#
# You can also set these as plain environment variables instead of using
# a secrets file -- the app checks both.

ANTHROPIC_API_KEY = "sk-ant-your-real-key-here"

# Optional: override the demo login credentials.
APP_USERNAME = "demo"
APP_PASSWORD = "stocksense2026"
